# Copy this file to `.env` in ml_service/ and adjust as needed.
# Both api.py and infer.py load this automatically via python-dotenv
# (optional dependency -- if it's not installed, just export these as real
# environment variables instead; everything still works).

# ── LLM provider for notes_mode="llm" (Mode 2) ──────────────────────────────
# "ollama" or "llama_cpp". Both speak the same OpenAI-compatible
# /v1/chat/completions API, so switching providers is just changing these
# three values -- no code changes needed.
LLM_PROVIDER=llama_cpp

# The model name your server is actually serving. For llama.cpp this is the
# --alias you passed to llama-server.exe; for Ollama it's the model tag,
# e.g. "gemma4:e2b" (must already be pulled: `ollama pull gemma4:e2b`).
LLM_MODEL=gemma4

# Base URL of the OpenAI-compatible endpoint.
#   llama.cpp (llama-server.exe --port 8081): http://127.0.0.1:8081/v1
#   Ollama (default port 11434):              http://127.0.0.1:11434/v1
LLM_BASE_URL=http://127.0.0.1:8081/v1

# ── Recognition confidence ──────────────────────────────────────────────────
# Default threshold for the /process (video upload) endpoint. Per-request
# overridable via the `threshold` form field; this just sets the default.
# Note: the live webcam session uses its own separate threshold, configured
# in the frontend (see frontend/.env.example) -- see ARCHITECTURE.md for why
# the two flows intentionally use different confidence-handling policies.
CONFIDENCE_THRESHOLD=0.4

# ── Long-video inference batching ───────────────────────────────────────────
# How many sliding windows to run through the model per forward pass. Lower
# this on constrained GPUs/CPUs; raise it if you have memory to spare and
# want faster processing of long videos.
INFER_CHUNK_SIZE=64
