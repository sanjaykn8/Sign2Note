# Copy to frontend/.env (or .env.local) to override. All optional.

# Gateway address. Default: the host this page was loaded from, port 3001
# (so other devices that open http://<main-laptop-ip>:8080 automatically
# use http://<main-laptop-ip>:3001). Users can also change it at runtime in
# the app under "Connection settings" (stored in the browser).
# VITE_API_URL=http://192.168.1.20:3001

# Client-side upload size check (MB). Keep in line with the gateway's
# MAX_UPLOAD_MB and the ML service's MAX_UPLOAD_SIZE.
# VITE_MAX_UPLOAD_MB=200

# The dev server's optional HTTPS certificate is configured with the
# environment variables SIGN2NOTES_HTTPS_KEY / SIGN2NOTES_HTTPS_CERT (paths
# to PEM files) in the shell that runs `npm run dev` -- see SETUP.md.
